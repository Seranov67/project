---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchDialog from '@/components/SearchDialog.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'OpsCards',
  description = 'Перевірені DevOps-команди з поясненням ризику та способом перевірити результат.',
  noindex = false,
} = Astro.props;
const pageTitle = title === 'OpsCards' ? 'OpsCards — DevOps-команди без зайвого' : `${title} · OpsCards`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#101923" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpsCards" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('opscards-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">До основного вмісту</a>
    <Header />
    <slot />
    <Footer />
    <SearchDialog />
  </body>
</html>
