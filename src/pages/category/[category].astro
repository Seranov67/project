---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SheetCatalog from '@/components/SheetCatalog.astro';
import { categories } from '@/data/catalog';
export async function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}
const { category } = Astro.props;
const entries = (await getCollection('cheatsheets')).filter((entry) => entry.data.category === category.slug).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title={category.label} description={category.description}><SheetCatalog entries={entries} title={category.label} description={category.description} /></BaseLayout>
