---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Редактор карток" noindex>
  <main class="shell editor-page" id="main-content">
    <div class="editor-heading"><div><p class="sheet-eyebrow">Робоча шпаргалка</p><h1>Редактор записів</h1><p>Назва, команда та пояснення — решта за потреби.</p></div><button class="editor-button editor-button-secondary" type="button" id="editor-logout" hidden>Вийти</button></div>
    <p class="editor-message" id="editor-message" role="status" aria-live="polite">Перевіряємо вхід…</p>
    <section id="editor-login" hidden><p>Для збереження увійдіть через GitHub. Доступ має лише власник довідника.</p><a class="editor-button" href="/api/editor?action=login">Увійти через GitHub</a></section>
    <section id="editor-app" hidden>
      <div class="editor-layout">
        <aside class="editor-sidebar"><button class="editor-button" type="button" id="editor-new">+ Нова картка</button><label for="editor-select">Мої записи</label><select id="editor-select"><option value="">Оберіть картку</option></select><a href="/">← До шпаргалки</a></aside>
        <div>
          <div class="editor-draft" id="editor-draft" hidden><span>Є незбережена чернетка цієї картки.</span><button type="button" class="editor-button editor-button-secondary" id="editor-restore">Відновити</button><button type="button" class="editor-button editor-button-secondary" id="editor-discard">Видалити чернетку</button></div>
          <form id="editor-form" class="editor-form" hidden>
            <h2 id="editor-form-title">Нова картка</h2>
            <label>Назва<input name="title" required maxlength="200" placeholder="Наприклад: Перезапустити DNS" /></label>
            <label>Команда або клавіші<textarea name="quickCmd" rows="2" maxlength="2000" placeholder="sudo systemctl restart systemd-resolved"></textarea></label>
            <label>Що робить<textarea name="description" required maxlength="1000" rows="2" placeholder="Коротке пояснення своїми словами"></textarea></label>
            <div class="editor-row"><label>Тема<select name="category" required><option value="linux">Файли та диски</option><option value="services">Служби та журнали</option><option value="windows">Windows та застосунки</option><option value="containers">Контейнери</option><option value="network">Мережа та доступ</option><option value="git">Git</option><option value="operations">Робочі інструменти</option></select></label><fieldset><legend>Платформа</legend><label><input type="checkbox" name="platform" value="linux" /> Linux</label><label><input type="checkbox" name="platform" value="windows" /> Windows</label><label><input type="checkbox" name="platform" value="macos" /> macOS</label></fieldset></div>
            <details class="editor-advanced"><summary>Додаткові налаштування та інструкція</summary><label>Адреса картки<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="80" placeholder="restart-dns" /><small>Створюється з назви. Для наявного запису адреса залишається постійною.</small></label><label>Теги<input name="tags" placeholder="dns, resolved" /><small>Через кому. Тег shortcuts додає запис до аркуша «Клавіші».</small></label><label>Додаткові кроки й пояснення<textarea name="body" rows="12" maxlength="50000" placeholder="Необов’язково. Текст у форматі Markdown."></textarea></label></details>
            <div class="editor-save-row"><button class="editor-button" type="submit" id="editor-save">Зберегти картку</button><span class="editor-help" id="editor-dirty">Зміни зберігаються через GitHub.</span></div>
            <p class="editor-help">Картки публічні. Незбережена чернетка залишається в цій вкладці браузера.</p>
          </form>
          <div class="editor-publication" id="editor-publication" hidden><p id="editor-publication-message" aria-live="polite"></p><button class="editor-button editor-button-secondary" type="button" id="editor-check-publication">Перевірити публікацію</button><a id="editor-published-link" href="/" hidden>Відкрити картку →</a></div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
  .editor-page { max-width: 78rem; padding-block: 2rem 5rem; }
  .editor-heading { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  h1 { margin: 0; font: 400 clamp(2rem,4vw,3rem)/1.15 Georgia,serif; letter-spacing: -.04em; }
  .editor-heading p:last-child { color:var(--ink-soft); font-size:.85rem; }
  .editor-message:empty { display:none; }
  .editor-message { padding:.8rem 0; border-bottom:1px solid var(--line); }
  .editor-layout { display:grid; grid-template-columns:16rem minmax(0,1fr); gap:2.5rem; margin-top:1.5rem; }
  .editor-sidebar,.editor-form { display:grid; align-content:start; gap:1rem; }
  .editor-sidebar { font-size:.85rem; }
  .editor-sidebar a { color:var(--ink-soft); }
  .editor-form { max-width:50rem; }
  .editor-sidebar label,.editor-form label { display:grid; gap:.35rem; font-size:.85rem; font-weight:600; }
  .editor-form h2 { margin:0; font:400 1.6rem/1.2 Georgia,serif; }
  input:not([type=checkbox]),textarea,select { width:100%; min-width:0; padding:.7rem; border:1px solid var(--line-strong); border-radius:var(--radius-sm); background:var(--surface); color:var(--ink); }
  textarea { resize:vertical; }
  textarea[name=quickCmd],textarea[name=body] { font: .85rem/1.6 var(--mono); }
  small,.editor-help { font-size:.76rem; font-weight:400; color:var(--ink-soft); }
  .editor-row { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  fieldset { display:flex; gap:.8rem; flex-wrap:wrap; margin:0; border:1px solid var(--line); }
  fieldset label { display:flex!important; align-items:center; gap:.3rem!important; }
  .editor-button { display:inline-block; width:fit-content; padding:.65rem .9rem; border:1px solid var(--accent); background:var(--accent); color:var(--bg); font-size:.8rem; font-weight:650; text-decoration:none; cursor:pointer; }
  .editor-button-secondary { background:transparent; color:var(--ink); border-color:var(--line-strong); }
  .editor-button:disabled { opacity:.55; cursor:wait; }
  .editor-advanced { border-block:1px solid var(--line); padding-block:.8rem; }
  .editor-advanced>summary { color:var(--ink-soft); font-size:.82rem; cursor:pointer; }
  .editor-advanced label { margin-top:1rem; }
  .editor-save-row { display:flex; align-items:center; flex-wrap:wrap; gap:1rem; }
  .editor-draft { display:flex; align-items:center; flex-wrap:wrap; gap:.7rem; padding:.85rem; margin-bottom:1rem; background:var(--accent-soft); font-size:.8rem; }
  .editor-publication { padding-top:1rem; border-top:1px solid var(--line); margin-top:1.5rem; font-size:.85rem; }
  .editor-publication .editor-button { margin-right:.7rem; }
  @media(max-width:700px) { .editor-layout,.editor-row { grid-template-columns:1fr; gap:1.5rem; } input:not([type=checkbox]),textarea,select { font-size:1rem; } .editor-heading { flex-wrap:wrap; } }
</style>
<script is:inline type="module" src="/editor.js"></script>
