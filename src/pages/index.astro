---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CheatCard from '@/components/CheatCard.astro';
import CardDrawer from '@/components/CardDrawer.astro';
import { categories } from '@/data/catalog';

const entries = (await getCollection('cheatsheets')).sort((a, b) => a.data.order - b.data.order);
const workIds = ['ansible-control-node', 'midnight-commander-files', 'windows-gpo-msi', 'windows-rdp-client', 'linux-dns-wireguard', 'rsync-remote-copy', 'guardant-network-license'];
const categoryCounts = Object.fromEntries(categories.map((category) => [category.slug, entries.filter((entry) => entry.data.category === category.slug).length]));

---

<BaseLayout>
  <main id="main-content">
    <section class="app-hero shell" aria-labelledby="hero-title" data-pagefind-ignore>
      <div class="app-hero-row">
        <div>
          <p class="eyebrow">DevOps & SysAdmin Workspace</p>
          <h1 id="hero-title" class="app-hero-title">Команда. Контекст. <em>Перевірка.</em></h1>
          <p class="app-hero-lede">Короткі перевірені сценарії для Linux, Windows та мережі: що виконати, який ризик і як переконатися в результаті.</p>
        </div>
        <div class="app-hero-actions">
          <label class="catalog-search" for="catalog-search-input">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
            <span class="sr-only">Пошук у каталозі</span>
            <input id="catalog-search-input" type="search" placeholder="Команда, задача або помилка…" autocomplete="off" data-catalog-search />
            <kbd>/</kbd>
          </label>
          <button class="search-everywhere" type="button" data-open-search aria-haspopup="dialog">
            Шукати всередині інструкцій <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </section>

    <section class="catalog-section command-center-section" id="catalog" aria-labelledby="catalog-title">
      <div class="shell command-center-layout">
        <aside class="workspace-nav" aria-label="Розділи довідника">
          <div class="workspace-nav-heading">
            <p class="eyebrow">Розділи</p>
            <strong>{entries.length} робочих карток</strong>
          </div>
          <nav class="workspace-categories">
            <button class="workspace-category is-active" type="button" data-category-filter="all" aria-pressed="true">
              <span class="workspace-category-mark" aria-hidden="true">⌘</span><span>Усі сценарії</span><small>{entries.length}</small>
            </button>
            <button class="workspace-category" type="button" data-category-filter="featured" aria-pressed="false">
              <span class="workspace-category-mark" aria-hidden="true">★</span><span>Часті</span><small>{workIds.length}</small>
            </button>
            {categories.map((category) => (
              <button class="workspace-category" type="button" data-category-filter={category.slug} aria-pressed="false">
                <span class="workspace-category-mark" aria-hidden="true">{category.mark}</span><span>{category.label}</span><small>{categoryCounts[category.slug]}</small>
              </button>
            ))}
          </nav>
          <div class="workspace-nav-note">
            <kbd>/</kbd>
            <span>Фокус на пошук</span>
          </div>
        </aside>

        <div class="workspace-results">
        <h2 id="catalog-title" class="sr-only">Каталог карток OpsCards</h2>

        <div class="filters" aria-label="Фільтри каталогу">
          <div class="active-section-label"><span>Перегляд</span><strong data-active-section>Усі сценарії</strong></div>
          <label class="platform-filter">
            <span>Платформа</span>
            <select data-platform-filter>
              <option value="all">Усі платформи</option>
              <option value="linux">Linux</option>
              <option value="windows">Windows</option>
              <option value="macos">macOS</option>
            </select>
          </label>
        </div>

        <div class="catalog-subhead" data-pagefind-ignore>
          <span class="catalog-count"><strong id="visible-count">{entries.length}</strong> <span id="result-label">сценаріїв</span></span>
          <button class="catalog-reset" type="button" data-catalog-reset hidden>Очистити фільтри</button>
        </div>

        <div class="cheat-grid" data-catalog-grid>
          {entries.map((entry) => (
            <CheatCard
              entry={entry}
              featured={workIds.includes(entry.id)}
              workspace
            />
          ))}
        </div>
        <p class="catalog-empty" data-catalog-empty hidden>Для цієї комбінації ще немає карток.</p>
        </div>

        <CardDrawer />
      </div>
    </section>

    <section class="principle-strip" aria-label="Принцип OpsCards" data-pagefind-ignore>
      <div class="shell principle-inner">
        <p>Не просто <code>що виконати</code>, а й <strong>що зміниться</strong> та <strong>як це перевірити</strong>.</p>
        <a href="/about">Як ми перевіряємо картки <span aria-hidden="true">→</span></a>
      </div>
    </section>

  </main>
</BaseLayout>

<script>
  const categoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-filter]'));
  const platformSelect = document.querySelector<HTMLSelectElement>('[data-platform-filter]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-catalog-card]'));
  const empty = document.querySelector<HTMLElement>('[data-catalog-empty]');
  const countEl = document.getElementById('visible-count');
  const resultLabel = document.getElementById('result-label');
  const searchInput = document.querySelector<HTMLInputElement>('[data-catalog-search]');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-catalog-reset]');
  const activeSection = document.querySelector<HTMLElement>('[data-active-section]');
  let activeCategory = 'all';

  const applyFilters = () => {
    const platform = platformSelect?.value ?? 'all';
    const query = (searchInput?.value ?? '').trim().toLocaleLowerCase('uk');
    let visible = 0;

    for (const card of cards) {
      let categoryMatch = false;
      if (activeCategory === 'all') {
        categoryMatch = true;
      } else if (activeCategory === 'featured') {
        categoryMatch = card.dataset.featured === 'true';
      } else {
        categoryMatch = card.dataset.category === activeCategory;
      }

      const platformMatch = platform === 'all' || (card.dataset.platforms ?? '').split(',').includes(platform);
      const searchable = card.dataset.search ?? '';
      const searchMatch = !query || query.split(/\s+/).every((token) => searchable.includes(token));
      card.hidden = !(categoryMatch && platformMatch && searchMatch);
      if (!card.hidden) visible += 1;
    }

    if (empty) empty.hidden = visible !== 0;
    if (countEl) countEl.textContent = String(visible);
    if (resultLabel) resultLabel.textContent = query ? 'знайдено' : 'сценаріїв';
    if (resetButton) resetButton.hidden = activeCategory === 'all' && platform === 'all' && !query;
  };

  categoryButtons.forEach((button) => button.addEventListener('click', () => {
    activeCategory = button.dataset.categoryFilter ?? 'all';
    categoryButtons.forEach((candidate) => {
      const active = candidate === button;
      candidate.classList.toggle('is-active', active);
      candidate.setAttribute('aria-pressed', String(active));
    });
    if (activeSection) activeSection.textContent = button.querySelector('span:nth-child(2)')?.textContent?.trim() ?? 'Усі сценарії';
    applyFilters();
  }));

  platformSelect?.addEventListener('change', applyFilters);
  searchInput?.addEventListener('input', applyFilters);
  resetButton?.addEventListener('click', () => {
    activeCategory = 'all';
    if (platformSelect) platformSelect.value = 'all';
    if (searchInput) searchInput.value = '';
    categoryButtons.forEach((button) => {
      const active = button.dataset.categoryFilter === 'all';
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    if (activeSection) activeSection.textContent = 'Усі сценарії';
    applyFilters();
    searchInput?.focus();
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    if (event.key === '/' && !target.matches('input, textarea, select, [contenteditable="true"]')) {
      event.preventDefault();
      searchInput?.focus();
    }
  });

  // Copy command buttons on cards
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cmd]');
    if (!btn) return;
    e.stopPropagation();
    const cmd = btn.dataset.cmd ?? '';
    navigator.clipboard.writeText(cmd).then(() => {
      btn.setAttribute('data-copied', '');
      setTimeout(() => btn.removeAttribute('data-copied'), 1800);
    });
  });
</script>
