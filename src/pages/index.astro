---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CheatCard from '@/components/CheatCard.astro';
import CardDrawer from '@/components/CardDrawer.astro';
import { categories } from '@/data/catalog';

const entries = (await getCollection('cheatsheets')).sort((a, b) => a.data.order - b.data.order);
const workIds = ['ansible-control-node', 'windows-gpo-msi', 'windows-rdp-client', 'linux-dns-wireguard', 'rsync-remote-copy', 'guardant-network-license'];

const renderedEntries = await Promise.all(
  entries.map(async (entry) => {
    const { Content, headings } = await render(entry);
    return { entry, Content, headings };
  })
);
---

<BaseLayout>
  <main id="main-content">
    <section class="app-hero shell" aria-labelledby="hero-title" data-pagefind-ignore>
      <div class="app-hero-row">
        <div>
          <p class="eyebrow">DevOps & SysAdmin Workspace</p>
          <h1 id="hero-title" class="app-hero-title">Команда. Контекст. <em>Перевірка.</em></h1>
          <p class="app-hero-lede">Короткі перевірені сценарії для Linux, Windows та мережі: що виконати, який ризик і як переконатися в результаті.</p>
        </div>
        <div class="app-hero-actions">
          <button class="hero-search app-hero-search" type="button" data-open-search aria-haspopup="dialog">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
            <span>
              <strong>Знайти команду</strong>
              <small>docker, wireguard, rdp, rsync…</small>
            </span>
            <kbd>/</kbd>
          </button>
        </div>
      </div>
    </section>

    <section class="catalog-section" id="catalog" aria-labelledby="catalog-title">
      <div class="shell">
        <h2 id="catalog-title" class="sr-only">Каталог карток OpsCards</h2>

        <div class="filters" aria-label="Фільтри каталогу">
          <div class="filter-group" role="group" aria-label="Категорія">
            <button class="filter-chip is-active" type="button" data-category-filter="all" aria-pressed="true">Усі</button>
            <button class="filter-chip" type="button" data-category-filter="featured" aria-pressed="false">⭐ Швидкі</button>
            {categories.map((category) => (
              <button class="filter-chip" type="button" data-category-filter={category.slug} aria-pressed="false">
                <span aria-hidden="true">{category.mark}</span> {category.label}
              </button>
            ))}
          </div>
          <label class="platform-filter">
            <span>Платформа</span>
            <select data-platform-filter>
              <option value="all">Усі платформи</option>
              <option value="linux">Linux</option>
              <option value="windows">Windows</option>
              <option value="macos">macOS</option>
            </select>
          </label>
        </div>

        <div class="catalog-subhead" data-pagefind-ignore>
          <span class="catalog-count"><strong id="visible-count">{entries.length}</strong> сценаріїв</span>
          <span class="catalog-hint">Клікніть будь-яку картку, щоб відкрити повні кроки</span>
        </div>

        <div class="cheat-grid" data-catalog-grid>
          {entries.map((entry) => (
            <CheatCard
              entry={entry}
              featured={workIds.includes(entry.id)}
            />
          ))}
        </div>
        <p class="catalog-empty" data-catalog-empty hidden>Для цієї комбінації ще немає карток.</p>
      </div>
    </section>

    <section class="principle-strip" aria-label="Принцип OpsCards" data-pagefind-ignore>
      <div class="shell principle-inner">
        <p>Не просто <code>що виконати</code>, а й <strong>що зміниться</strong> та <strong>як це перевірити</strong>.</p>
        <a href="/about">Як ми перевіряємо картки <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <CardDrawer renderedEntries={renderedEntries} />
  </main>
</BaseLayout>

<script>
  const categoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-filter]'));
  const platformSelect = document.querySelector<HTMLSelectElement>('[data-platform-filter]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-catalog-card]'));
  const empty = document.querySelector<HTMLElement>('[data-catalog-empty]');
  const countEl = document.getElementById('visible-count');
  let activeCategory = 'all';

  const applyFilters = () => {
    const platform = platformSelect?.value ?? 'all';
    let visible = 0;

    for (const card of cards) {
      let categoryMatch = false;
      if (activeCategory === 'all') {
        categoryMatch = true;
      } else if (activeCategory === 'featured') {
        categoryMatch = card.dataset.featured === 'true';
      } else {
        categoryMatch = card.dataset.category === activeCategory;
      }

      const platformMatch = platform === 'all' || (card.dataset.platforms ?? '').split(',').includes(platform);
      card.hidden = !(categoryMatch && platformMatch);
      if (!card.hidden) visible += 1;
    }

    if (empty) empty.hidden = visible !== 0;
    if (countEl) countEl.textContent = String(visible);
  };

  categoryButtons.forEach((button) => button.addEventListener('click', () => {
    activeCategory = button.dataset.categoryFilter ?? 'all';
    categoryButtons.forEach((candidate) => {
      const active = candidate === button;
      candidate.classList.toggle('is-active', active);
      candidate.setAttribute('aria-pressed', String(active));
    });
    applyFilters();
  }));

  platformSelect?.addEventListener('change', applyFilters);

  // Copy command buttons on cards
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cmd]');
    if (!btn) return;
    e.stopPropagation();
    const cmd = btn.dataset.cmd ?? '';
    navigator.clipboard.writeText(cmd).then(() => {
      btn.setAttribute('data-copied', '');
      setTimeout(() => btn.removeAttribute('data-copied'), 1800);
    });
  });
</script>
