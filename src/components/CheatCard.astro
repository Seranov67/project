---
import type { CollectionEntry } from 'astro:content';
import { getCategory, platformLabels, riskLabels } from '@/data/catalog';

interface Props {
  entry: CollectionEntry<'cheatsheets'>;
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
const category = getCategory(entry.data.category);
const cmd = entry.data.quickCmd;
---

<article
  class={`cheat-card${featured ? ' cheat-card--featured' : ''}`}
  data-catalog-card
  data-card-id={entry.id}
  data-category={entry.data.category}
  data-platforms={entry.data.platforms.join(',')}
>
  <div class="card-topline">
    <a class="category-label" href={`/category/${entry.data.category}`}>
      <span aria-hidden="true">{category?.mark}</span> {category?.label}
    </a>
    <span class={`risk-badge risk-${entry.data.risk}`}>{riskLabels[entry.data.risk]}</span>
  </div>
  <h3>
    <a href={`/cards/${entry.id}`} data-open-drawer={entry.id}>
      {entry.data.title}
    </a>
  </h3>
  <p>{entry.data.description}</p>

  {cmd && (
    <div class="card-cmd" data-card-cmd>
      <code class="card-cmd-text" title={cmd}>{cmd}</code>
      <button
        class="card-cmd-copy"
        type="button"
        aria-label="Скопіювати команду"
        title="Скопіювати команду в буфер"
        data-cmd={cmd}
      >
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <rect x="4" y="4" width="9" height="11" rx="1.5" />
          <path d="M3 3V2a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v1" />
        </svg>
        <span class="card-cmd-copied">✓</span>
      </button>
    </div>
  )}

  <div class="card-meta">
    <span>{entry.data.testedWith}</span>
    <span aria-hidden="true">·</span>
    <span>{entry.data.platforms.map((platform) => platformLabels[platform]).join(' / ')}</span>
  </div>
  <a
    class="card-link"
    href={`/cards/${entry.id}`}
    data-open-drawer={entry.id}
    aria-label={`Відкрити деталі сценарію «${entry.data.title}»`}
  >
    <span>Сценарій та кроки</span>
    <span class="card-link-arrow" aria-hidden="true">→</span>
  </a>
</article>
