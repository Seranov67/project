<div class="card-drawer-root" id="card-drawer-root" aria-label="Перегляд сценарію">
  <div class="drawer-backdrop" data-drawer-close aria-hidden="true"></div>
  <aside class="drawer-panel" aria-live="polite">
    <div class="drawer-empty" data-drawer-empty>
      <div class="drawer-empty-mark" aria-hidden="true">⌘</div>
      <p class="eyebrow">Робоча область</p>
      <h2>Оберіть сценарій</h2>
      <p>Інструкція відкриється тут без переходу на іншу сторінку.</p>
      <ul><li>ризик перед виконанням;</li><li>команда з копіюванням;</li><li>перевірка результату.</li></ul>
    </div>
    <div class="drawer-loading" data-drawer-loading hidden>
      <span class="drawer-loader" aria-hidden="true"></span>
      <p>Завантажуємо перевірену інструкцію…</p>
    </div>
    <div class="drawer-content" data-drawer-content hidden>
      <header class="drawer-header-bar">
        <div class="drawer-badges">
          <span class="category-label drawer-category" id="drawer-category"></span>
          <span class="risk-badge drawer-risk" id="drawer-risk"></span>
        </div>
        <div class="drawer-header-actions">
          <a class="drawer-fullscreen-link" id="drawer-fullscreen" href="#">
            <span>Окрема сторінка</span>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3h7v7M13 3 8 8" /></svg>
          </a>
          <button class="drawer-close-btn" type="button" data-drawer-close aria-label="Закрити панель" title="Закрити (Esc)">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </button>
        </div>
      </header>
      <div class="drawer-scroll-body" id="drawer-scroll-body">
        <article class="drawer-article" data-drawer-article></article>
      </div>
    </div>
  </aside>
</div>

<script>
  const root = document.getElementById('card-drawer-root');
  const emptyState = root?.querySelector<HTMLElement>('[data-drawer-empty]');
  const loadingState = root?.querySelector<HTMLElement>('[data-drawer-loading]');
  const contentState = root?.querySelector<HTMLElement>('[data-drawer-content]');
  const article = root?.querySelector<HTMLElement>('[data-drawer-article]');
  const scrollBody = document.getElementById('drawer-scroll-body');
  const categoryField = document.getElementById('drawer-category');
  const riskField = document.getElementById('drawer-risk');
  const fullscreenLink = document.getElementById('drawer-fullscreen') as HTMLAnchorElement | null;
  const cache = new Map<string, string>();
  let activeCardId: string | null = null;

  const enhanceContent = (container: HTMLElement) => {
    container.querySelectorAll<HTMLElement>('pre').forEach((pre) => {
      const code = pre.querySelector('code');
      if (!code || pre.querySelector('.copy-button')) return;
      const button = document.createElement('button');
      button.className = 'copy-button';
      button.type = 'button';
      button.textContent = 'Копіювати';
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          button.textContent = 'Скопійовано';
          button.dataset.copied = 'true';
        } catch {
          button.textContent = 'Не вдалося';
        }
        window.setTimeout(() => {
          button.textContent = 'Копіювати';
          delete button.dataset.copied;
        }, 1600);
      });
      pre.append(button);
    });
    container.querySelectorAll<HTMLElement>('blockquote').forEach((note) => {
      const text = note.textContent?.toLocaleLowerCase('uk') ?? '';
      if (text.includes('незворотно')) note.classList.add('risk-note-destructive');
      else if (text.includes('безпечно')) note.classList.add('risk-note-safe');
      else note.classList.add('risk-note-changes');
    });
  };

  const getCardHtml = async (cardId: string) => {
    const cached = cache.get(cardId);
    if (cached) return cached;
    const response = await fetch(`/cards/${cardId}/`);
    if (!response.ok) throw new Error(`Card request failed: ${response.status}`);
    const documentHtml = new DOMParser().parseFromString(await response.text(), 'text/html');
    const title = documentHtml.querySelector('.cheat-header h1')?.outerHTML ?? '';
    const description = documentHtml.querySelector('.cheat-description')?.outerHTML ?? '';
    const facts = documentHtml.querySelector('.fact-row')?.outerHTML ?? '';
    const prose = documentHtml.querySelector('.prose')?.outerHTML ?? '';
    const sources = documentHtml.querySelector('.source-panel')?.outerHTML ?? '';
    const html = `${title}${description}${facts}${prose}${sources}`;
    cache.set(cardId, html);
    return html;
  };

  const setActiveCard = (cardId: string | null) => {
    document.querySelectorAll<HTMLElement>('[data-catalog-card]').forEach((card) => {
      card.classList.toggle('is-active', card.dataset.cardId === cardId);
    });
  };

  const openDrawer = async (cardId: string, updateUrl = true) => {
    const card = document.querySelector<HTMLElement>(`[data-card-id="${CSS.escape(cardId)}"]`);
    if (!root || !article || !card) return;
    activeCardId = cardId;
    root.classList.add('is-open');
    document.body.classList.add('has-drawer-open');
    emptyState?.setAttribute('hidden', '');
    contentState?.setAttribute('hidden', '');
    loadingState?.removeAttribute('hidden');
    setActiveCard(cardId);
    if (categoryField) categoryField.innerHTML = `<span aria-hidden="true">${card.dataset.categoryMark ?? ''}</span> ${card.dataset.categoryLabel ?? ''}`;
    if (riskField) {
      riskField.textContent = card.dataset.riskLabel ?? '';
      riskField.className = `risk-badge drawer-risk ${card.dataset.riskClass ?? ''}`;
    }
    if (fullscreenLink) fullscreenLink.href = `/cards/${cardId}/`;
    try {
      const html = await getCardHtml(cardId);
      if (activeCardId !== cardId) return;
      article.innerHTML = html;
      enhanceContent(article);
      loadingState?.setAttribute('hidden', '');
      contentState?.removeAttribute('hidden');
      if (scrollBody) scrollBody.scrollTop = 0;
      if (updateUrl) history.replaceState(null, '', `#card-${cardId}`);
    } catch {
      loadingState?.setAttribute('hidden', '');
      article.innerHTML = '<div class="drawer-error"><h2>Не вдалося завантажити картку</h2><p>Відкрийте сценарій на окремій сторінці або повторіть спробу.</p></div>';
      contentState?.removeAttribute('hidden');
    }
  };

  const closeDrawer = () => {
    if (!root) return;
    root.classList.remove('is-open');
    document.body.classList.remove('has-drawer-open');
    activeCardId = null;
    setActiveCard(null);
    contentState?.setAttribute('hidden', '');
    loadingState?.setAttribute('hidden', '');
    emptyState?.removeAttribute('hidden');
    if (window.location.hash.startsWith('#card-')) history.replaceState(null, '', window.location.pathname + window.location.search);
  };

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-drawer-close]')) { closeDrawer(); return; }
    if (target.closest('[data-cmd]')) return;
    const trigger = target.closest<HTMLElement>('[data-open-drawer]');
    if (!trigger) return;
    const mouseEvent = event as MouseEvent;
    if (mouseEvent.ctrlKey || mouseEvent.metaKey || mouseEvent.shiftKey || mouseEvent.button !== 0) return;
    event.preventDefault();
    const cardId = trigger.getAttribute('data-open-drawer');
    if (cardId) openDrawer(cardId);
  });
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && root?.classList.contains('is-open')) closeDrawer();
  });
  const initialCard = window.location.hash.startsWith('#card-') ? window.location.hash.replace('#card-', '') : '';
  if (initialCard) {
    openDrawer(initialCard, false);
  } else if (window.matchMedia('(min-width: 1101px)').matches) {
    const firstCard = document.querySelector<HTMLElement>('[data-catalog-card]');
    const firstCardId = firstCard?.dataset.cardId;
    if (firstCardId) openDrawer(firstCardId, false);
  }
  window.addEventListener('hashchange', () => {
    const cardId = window.location.hash.startsWith('#card-') ? window.location.hash.replace('#card-', '') : '';
    if (cardId && cardId !== activeCardId) openDrawer(cardId, false);
  });
</script>
